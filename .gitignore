.venv/
__pycache__/
.DS_Store
# DCD8/DCD10: the raw 311 data lives in git so CI only ever fetches the CURRENT
# year (never re-pulling ~20 years each run). We track the unified per-year
# checkpoints (_all_<year>.csv — all records, all fields), the change-token
# (source_counts.json), the SMD boundaries and the neighborhood label points.
# The old per-signal combined reports CSVs are derived/legacy, so stay ignored.
data/raw/*_reports.csv
# in-progress fetch pages (resumable); only the atomically-renamed final is tracked
data/raw/*.part
